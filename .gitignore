# ---- Salidas de compilación ----
/build/
app/build/
.cxx/
.externalNativeBuild/

# ---- Caché de Gradle (local, no el wrapper) ----
.gradle/

# ---- Configuración local del entorno ----
# Contiene la ruta al SDK de Android de la máquina local, no es portable.
local.properties

# ---- Android Studio / IntelliJ ----
# .idea/ se regenera desde los archivos Gradle al sincronizar. Commitearlo
# solo produce conflictos de merge entre configuraciones de distintos desarrolladores.
*.iml
.idea/

# ---- APKs y keystores ----
*.apk
*.aab
*.jks
*.keystore

# ---- OS ----
.DS_Store
Thumbs.db
